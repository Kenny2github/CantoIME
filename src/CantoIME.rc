// CantoIME.rc
//
// The CantoIME options dialog (see OptionsDialog.cpp). The input-indicator icon
// is generated separately as a .res (see CMakeLists / tools/make-canto-icon.ps1),
// so it is NOT defined here.

#include <windows.h>
#include "resource.h"

IDD_OPTIONS DIALOGEX 0, 0, 300, 322
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CantoIME Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Dictionary:", IDC_STATIC, 10, 12, 120, 9
    COMBOBOX        IDC_DICT_MODE, 10, 24, 208, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_DICT_PATH, 10, 44, 208, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 226, 43, 62, 16

    LTEXT           "Chinese/English toggle key:", IDC_STATIC, 10, 72, 124, 9
    COMBOBOX        IDC_TOGGLE, 140, 70, 148, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Candidate font size:", IDC_STATIC, 10, 96, 124, 9
    COMBOBOX        IDC_FONTSIZE, 140, 94, 62, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Custom candidates", IDC_STATIC, 10, 116, 280, 172
    LTEXT           "Associate a romanization key with extra candidates. Select an entry to edit it, then Add / Update or Remove.",
                    IDC_STATIC, 18, 128, 264, 18
    LISTBOX         IDC_OVR_LIST, 18, 150, 264, 82,
                    LBS_NOTIFY | LBS_USETABSTOPS | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "Key:", IDC_STATIC, 18, 240, 22, 9
    EDITTEXT        IDC_OVR_KEY, 40, 238, 78, 14, ES_AUTOHSCROLL | ES_LOWERCASE
    LTEXT           "Candidates:", IDC_STATIC, 124, 240, 42, 9
    EDITTEXT        IDC_OVR_CANDS, 168, 238, 114, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Add / Update", IDC_OVR_ADD, 128, 262, 74, 16
    PUSHBUTTON      "Remove", IDC_OVR_REMOVE, 208, 262, 74, 16

    DEFPUSHBUTTON   "OK", IDOK, 176, 298, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 236, 298, 52, 16
END
