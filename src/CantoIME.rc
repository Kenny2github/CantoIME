// CantoIME.rc
//
// The "Keyboard options" dialog shown by ITfFnConfigure::Show (see
// OptionsDialog.cpp). The input-indicator icon is generated separately as a .res
// (see CMakeLists / tools/make-canto-icon.ps1), so it is NOT defined here.

#include <windows.h>
#include "resource.h"

IDD_OPTIONS DIALOGEX 0, 0, 300, 176
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "CantoIME Options"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Dictionary:", IDC_STATIC, 10, 12, 120, 9
    COMBOBOX        IDC_DICT_MODE, 10, 24, 208, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_DICT_PATH, 10, 44, 208, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 226, 43, 62, 16

    LTEXT           "Chinese/English toggle key:", IDC_STATIC, 10, 72, 124, 9
    COMBOBOX        IDC_TOGGLE, 140, 70, 148, 100,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Candidate font size:", IDC_STATIC, 10, 96, 124, 9
    COMBOBOX        IDC_FONTSIZE, 140, 94, 62, 160,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Changes take effect next time you switch to CantoIME.",
                    IDC_STATIC, 10, 124, 278, 9

    DEFPUSHBUTTON   "OK", IDOK, 176, 150, 52, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 236, 150, 52, 16
END
